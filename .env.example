# ─────────────────────────────────────────────────────────────
#  Administration — OBLIGATOIRE
# ─────────────────────────────────────────────────────────────
# Code d'accès à /studio. Choisissez quelque chose de long et
# sans rapport avec le mot de passe de Sofia.
ADMIN_SECRET_KEY=changez-moi-pour-quelque-chose-de-long-et-unique

# ─────────────────────────────────────────────────────────────
#  Supabase — recommandé (persistance + téléversements)
# ─────────────────────────────────────────────────────────────
# Sans ces clés, l'application fonctionne quand même :
#   • la configuration est écrite dans .data/config.json
#   • les fichiers sont écrits dans public/uploads/
# Ce repli convient au test local, mais pas à Vercel
# (système de fichiers en lecture seule).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optionnelle. Permet au serveur d'écrire dans site_config même
# avec des politiques RLS strictes. Ne jamais l'exposer au client.
SUPABASE_SERVICE_ROLE_KEY=
